{
  "name": "deriva-monorepo",
  "version": "0.3.1",
  "private": true,
  "description": "DERIVA – moderne Plattform zur Bewertung von Zins- und Währungsderivaten (Pricing-Core, API, Web-UI mit Hotkeys)",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build": "pnpm --filter @deriva/pricing-core run build && pnpm --filter @deriva/api run build && pnpm --filter @deriva/web run build",
    "build:core": "pnpm --filter @deriva/pricing-core run build",
    "pretest": "pnpm run build:core",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test -- --coverage",
    "pretypecheck": "pnpm run build:core",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:commits": "commitlint --from ${COMMITLINT_FROM:-HEAD~1} --to HEAD --verbose",
    "dev": "pnpm -w run --parallel --stream \"/^dev:(core|api|web)$/\"",
    "dev:core": "pnpm --filter @deriva/pricing-core exec tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:web": "pnpm --filter @deriva/web run dev",
    "dev:api": "pnpm --filter @deriva/api run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0"
  },
  "type": "module"
}
