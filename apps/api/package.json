{
  "name": "@deriva/api",
  "version": "0.3.1",
  "private": true,
  "description": "DERIVA REST API – Pricing, Kurven, Marktdaten, Trades, Szenarien (Fastify + OpenAPI)",
  "type": "module",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@deriva/pricing-core": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
