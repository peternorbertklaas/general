{
  "name": "@deriva/pricing-core",
  "version": "0.3.0",
  "description": "Pricing engine for interest rate and FX derivatives: calendars, day counts, schedules, multi-curve bootstrapping, IRS/OIS/FRA/Cap/Floor/Swaption, FX forward/option/CCS, sensitivities and scenarios.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "version:gen": "node tools/gen-version.mjs",
    "prebuild": "node tools/gen-version.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "node tools/gen-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  }
}
